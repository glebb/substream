# Copy this file to .env and paste the complete provider URL.
# Never commit the real URL: it commonly contains IPTV credentials.
IPTV_M3U_URL=https://provider.example/get.php?username=YOUR_USERNAME&password=YOUR_PASSWORD&type=m3u_plus&output=ts

# Optional playlist-size safety cap. Increase only when your provider requires it.
IPTV_M3U_MAX_MB=250
OPENSUBTITLES_API_KEY=

# TMDb metadata credentials (required by personal build commands). The read access token is preferred;
# the API key is accepted as a fallback. Never commit a real .env file.
TMDB_API_READ_ACCESS_TOKEN=
TMDB_API_KEY=

# Optional default registered LG TV for `npm run deploy` (no argument).
# Deployment-only: never embedded in either TV app. Use your local CLI device name.
LG_WEBOS_DEVICE=lg-tv-example

# Optional non-secret LAN address for the local TV playback relay.
# Keep http for the simplest trusted-LAN setup; use https when TLS is configured
# with COMPANION_TLS_CERT and COMPANION_TLS_KEY in the relay process environment.
# This value is embedded in local builds so the TV can start pairing directly.
COMPANION_SERVER_URL=http://192.168.1.50:8787
