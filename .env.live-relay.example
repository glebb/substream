# npm run relay:personal or a personal Tizen build creates .env.live-relay
# automatically, using this Mac's private IPv4 and a persistent random token.
# This template documents optional overrides; no copying/editing is required.
# Public deployment: use the hosted HTTPS URL and set ALLOW_LAN_HTTP=0.
# See docs/live-subtitle-relay-deployment.md; saved TV overrides take precedence.
LIVE_SUBTITLE_RELAY_ENABLED=1
LIVE_SUBTITLE_RELAY_URL=http://192.168.1.50:8790
LIVE_SUBTITLE_RELAY_TOKEN=
LIVE_SUBTITLE_RELAY_ALLOW_LAN_HTTP=1
LIVE_SUBTITLE_RELAY_HOST=0.0.0.0
LIVE_SUBTITLE_RELAY_PORT=8790
# Packaged TV widgets normally send an opaque Origin: null.
LIVE_SUBTITLE_RELAY_ALLOWED_ORIGINS=null
# Empty permits rotating public CDN hosts with DNS validation/pinning per hop.
# An explicit comma-separated list opts back into a fixed redirect host policy.
LIVE_SUBTITLE_RELAY_REDIRECT_HOSTS=
